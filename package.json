{
  "name": "theboringmcp",
  "version": "2.0.1",
  "description": "MCP server for Claude: Home Assistant, Sonarr, Radarr, SABnzbd, Jellyfin, Portainer, UniFi and n8n – full read/write access, on/off switch per app",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "theboringmcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "home-assistant",
    "sonarr",
    "radarr",
    "sabnzbd",
    "jellyfin",
    "portainer",
    "unifi",
    "n8n",
    "homelab",
    "claude"
  ],
  "author": "Alex",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "undici": "^6.21.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
